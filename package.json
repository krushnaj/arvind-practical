{
  "name": "arvind-quality-tracker",
  "version": "1.0.0",
  "description": "Quality Inspection Tracker for Arvind Fabric Manufacturing Plants",
  "main": "server/index.ts",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build && tsc -p server/tsconfig.json",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx server/seed.ts"
  },
  "keywords": [
    "arvind",
    "quality-inspection",
    "textile-manufacturing",
    "shopfloor",
    "mobile-first"
  ],
  "author": "Arvind AI & Analytics Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.12.0",
    "@types/supertest": "^7.1.3",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

